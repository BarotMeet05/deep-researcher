# Application Settings
APP_NAME="DeepResearcher AI"
ENVIRONMENT="development"
DEBUG=false

# Security Passcode (protects API & Swagger docs)
APP_ACCESS_KEY="your-chosen-secret-passcode"

# ==============================================================================
# LLM Provider Configuration
# Choose: "gemini" (default) | "groq" | "custom" (HuggingFace / OpenAI compatible)
# ==============================================================================
LLM_PROVIDER="gemini"

# Option A: Google Gemini (Default - 100% Free 1,500 req/day)
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-2.5-flash"

# Option B: Groq Cloud (Free Open Source Llama 3.3 70B)
# To switch to Groq: set LLM_PROVIDER="groq" and provide your GROQ_API_KEY below
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Option C: Hugging Face or Custom OpenAI-Compatible Endpoint
# To switch: set LLM_PROVIDER="custom"
CUSTOM_LLM_API_KEY=""
CUSTOM_LLM_MODEL="meta-llama/Llama-3.1-8B-Instruct"
CUSTOM_LLM_BASE_URL="https://api-inference.huggingface.co/v1"

# Search Engine Configuration
# Option A: Tavily AI Search (Recommended - free 1,000 req/mo at https://tavily.com)
TAVILY_API_KEY=""

# If TAVILY_API_KEY is left empty, automatically falls back to DuckDuckGo multi-engine.

# CORS
ALLOWED_ORIGINS="*"
